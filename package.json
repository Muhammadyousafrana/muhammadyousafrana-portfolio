{
  "name": "ai-portfolio",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "content:build": "bun --no-env-file scripts/build-content.ts",
    "content:check": "bun --no-env-file scripts/build-content.ts --check",
    "predev": "bun run content:build",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "bun run content:build",
    "build": "vite build",
    "pretest": "bun run content:build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --cache --quiet .",
    "lint:fix": "eslint --cache --fix --quiet .",
    "typecheck": "bunx tsc -b --pretty false",
    "knip": "bunx knip --config knip.json",
    "check": "bun run content:check && bun run format:check && bun run lint && bun run typecheck && bun run knip",
    "check:fix": "bun run format && bun run lint:fix && bun run typecheck && bun run knip",
    "test": "bun test",
    "weather:smoke": "bun --no-env-file scripts/weather-smoke.ts",
    "preview": "bun run build && vite preview --host 0.0.0.0 --port ${PORT:-4173}",
    "prepare": "lefthook install",
    "predeploy:validate": "bun --no-env-file scripts/predeploy-validate.mjs",
    "smoke:ai": "bun --no-env-file scripts/smoke-ai-health.mjs",
    "smoke:ai:online": "bun --no-env-file scripts/smoke-ai-online.ts",
    "deploy:dry-run": "bun run predeploy:validate && bun run build && bunx wrangler deploy --dry-run --strict",
    "deploy": "bun run predeploy:validate && bun run build && bunx wrangler deploy --strict && bun run smoke:ai",
    "deploy:init": "bun run predeploy:validate && bun run build && bunx wrangler deploy --strict && echo 'First deploy done. Now set SECURITY_HMAC_SECRET and GOOGLE_GENERATIVE_AI_API_KEY (add TURNSTILE_SECRET_KEY if REQUIRE_TURNSTILE=true, and the Twilio secrets for SMS). Then set SMOKE_BASE_URL to your workers.dev URL and run: bun run smoke:ai' && (bun run smoke:ai || echo 'Smoke check did not pass yet (expected before secrets and SMOKE_BASE_URL are set).')",
    "cf-typegen": "bunx wrangler types"
  },
  "dependencies": {
    "@ai-sdk/google": "3.0.91",
    "@ai-sdk/provider": "3.0.8",
    "@ai-sdk/provider-utils": "4.0.19",
    "@ai-sdk/react": "3.0.118",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-slot": "^1.2.3",
    "ai": "6.0.116",
    "ai-gateway-provider": "3.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "framer-motion": "^12.23.0",
    "hono": "^4.9.8",
    "immer": "^10.1.1",
    "lucide-react": "^0.525.0",
    "pino": "^9.11.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^9.0.1",
    "react-router-dom": "6.30.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "workers-ai-provider": "3.3.1",
    "yaml": "^2.8.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.17.1",
    "@cloudflare/workers-types": "5.20260713.1",
    "@eslint/js": "^9.22.0",
    "@happy-dom/global-registrator": "^20.10.6",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "bun-types": "^1.3.10",
    "eslint": "^9.31.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "knip": "^5.85.0",
    "lefthook": "^2.1.3",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "puppeteer-core": "^25.15.0",
    "tailwindcss": "^3.4.17",
    "typescript": "5.8",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.3.1",
    "wrangler": "4.69.0"
  }
}
