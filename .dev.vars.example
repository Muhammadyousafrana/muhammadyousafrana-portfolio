# Copy this file to `.dev.vars` and fill in real values for local development
# (`bun run dev` / `wrangler dev`). `.dev.vars` is gitignored; never commit secrets.
# These are placeholders only.

# --- Required: AI chat + fit-analysis ---
# Create a Google AI Studio API key at
# https://aistudio.google.com/api-keys and keep it server-side in this file.
AI_PROVIDER=google-ai-studio
GOOGLE_GENERATIVE_AI_API_KEY=replace-with-your-google-ai-studio-key
# Secret used to sign session / challenge state. Use a long random string.
SECURITY_HMAC_SECRET=replace-with-a-long-random-string

# --- Turnstile bot protection (disabled by default: REQUIRE_TURNSTILE=false) ---
# Client widget site key. This is a Vite build-time var (VITE_ prefix) embedded in
# the browser bundle. Vite reads VITE_* from .env / .env.local (or the shell), NOT
# from .dev.vars — so it does NOT belong in this file. Put it in .env.local instead
# (left commented here as a reminder, not as a value this file loads):
#VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key
# Server-side Turnstile secret (Worker binding).
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# Set to "true" to enforce Turnstile on protected endpoints.
REQUIRE_TURNSTILE=false

# --- Optional: recruiter SMS contact flow (Twilio). Leave unset to disable. ---
# Destination phone number for the contact-form SMS handoff.
#CONTACT_SMS_TO_NUMBER=+15555550123
#TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#TWILIO_AUTH_TOKEN=your-twilio-auth-token
#TWILIO_FROM_NUMBER=+15555550100

# --- Optional: AI health probe bearer token ---
# When set, GET /api/health/ai requires `Authorization: Bearer <token>`.
#AI_HEALTH_TOKEN=your-health-probe-token
